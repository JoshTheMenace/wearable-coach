# Never put provider keys into the Android app or browser.
GEMINI_KEY=
OPENAI_API_KEY=
# Optional ordinary Gemini model for observer and delegated task interpretation.
OBSERVER_MODEL=gemini-3.8-flash
# Leave blank/omit to generate .runtime/operator-token.
# COACH_TOKEN=
HOST=127.0.0.1
PORT=8787
# TLS_CERT=/absolute/path/certificate.pem
# TLS_KEY=/absolute/path/private-key.pem
# ALLOW_INSECURE_LAN=1  # isolated development only; prefer adb reverse
