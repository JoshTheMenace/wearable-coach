{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
    "jsx": "react-jsx", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true, "types": ["node"]
  },
  "include": ["contracts/**/*.ts", "server/**/*.ts", "scripts/**/*.ts", "web/**/*.ts", "web/**/*.tsx"]
}
